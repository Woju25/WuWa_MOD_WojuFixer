<Window x:Class="WuWa_MOD_WojuFixer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Woju - WuWa MOD Fixer"
        Height="560" Width="900"
        WindowStartupLocation="CenterScreen"
        Icon="Woju.ico"
        Opacity="0.995">

    <Window.Resources>
        <!-- Rounded-rectangle style for all buttons -->
        <Style TargetType="Button">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#55000000"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"
                                              SnapsToDevicePixels="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#AAFFFFFF"/>
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Foreground>
        <ImageBrush/>
    </Window.Foreground>

    <Window.Background>
        <ImageBrush ImageSource="/Lily.png"
                    Opacity="0.7"/>
    </Window.Background>

    <Grid Margin="14">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="653*"/>
            <ColumnDefinition Width="39*"/>
            <ColumnDefinition Width="100*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Folder selection -->
        <Grid Grid.Row="1"
              Margin="0,0,0,10"
              Grid.ColumnSpan="3">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="9*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="FolderTextBox"
                     IsReadOnly="True"
                     Height="30"
                     VerticalContentAlignment="Center"
                     Padding="8,0,8,0"
                     BorderThickness="0"
                     Margin="0,0,10,0"
                     Text="Browse and select your WuWa mod folder..."
                     Grid.ColumnSpan="2"
                     Background="#FFCF7EFF"
                     FontWeight="Bold"
                     Foreground="White">
                <TextBox.Template>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </ControlTemplate>
                </TextBox.Template>
            </TextBox>

            <Button x:Name="BrowseButton"
                    Grid.Column="2"
                    Content="Browse..."
                    Width="120"
                    Height="30"
                    Click="BrowseButton_Click"
                    Background="White"
                    FontWeight="Bold"/>

        </Grid>

        <!-- Injection mode -->
        <Border Grid.Row="2"
                Grid.ColumnSpan="3"
                Margin="0,0,0,10"
                Padding="10,8"
                Background="#BFFFFFFF"
                BorderBrush="#80FFFFFF"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel>

                <TextBlock Text="Fixing mode (choose one):"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"
                       Foreground="Black"/>

                <RadioButton x:Name="InjectionNoneRadio"
                         GroupName="FixingMode"
                         Content="Hash Update - For Character Menu Fix"
                         IsChecked="True"
                         Margin="0,0,0,6"
                         FontWeight="SemiBold"
                         Background="White"
                         BorderBrush="#FF757575"
                         Foreground="Black"/>

                <RadioButton x:Name="InvisibleFixRadio"
                         GroupName="FixingMode"
                         Content="Invisibility Fix"
                         Margin="0,0,0,6"
                         FontWeight="SemiBold"
                         Background="White"
                         BorderBrush="#FF757575"
                         Foreground="Black"/>

                <RadioButton x:Name="StableTexturesRadio"
                         GroupName="FixingMode"
                         Content="StableTextures (Need Latest RabbitFX) - For Menu and Open World Fix"
                         Margin="0,0,0,6"
                         FontWeight="SemiBold"
                         Background="White"
                         BorderBrush="#FF757575"
                         Checked="StableTexturesRadio_Checked"
                         Foreground="Black">

                    <RadioButton.ToolTip>
                        <ToolTip Placement="Mouse"
                             MaxWidth="520">

                            <TextBlock TextWrapping="Wrap">
For Now StableTextures Injection Can Only Work For :
🔴 Female
Aemeath, Augusta, Cantarella, Carlotta, Cartethyia &amp; Fleurdelys, Chisa, Galbrena, Iuno, Lucilla, Lupa, Lynae, Mornye, Phrolova, Rover (F), Shorekeeper, Zani.
🔵 Male
Rover (M), Qiuyuan, Xiangli Yao
                            </TextBlock>

                        </ToolTip>
                    </RadioButton.ToolTip>

                </RadioButton>

                <RadioButton x:Name="HighLodStableRadio"
                         GroupName="FixingMode"
                         Content="High LOD (Under Development)"
                         Margin="0,0,0,0"
                         FontWeight="SemiBold"
                         Background="White"
                         BorderBrush="#FF757575"
                         Checked="HighLodStableRadio_Checked"
                         Foreground="Black"/>

            </StackPanel>
        </Border>

        <!-- Link buttons -->
        <Grid Grid.Row="4"
              Grid.ColumnSpan="3"
              Margin="0,0,0,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Frosted-glass panel behind the upper action buttons -->
            <Border Grid.ColumnSpan="2"
                    Background="#BFFFFFFF"
                    BorderBrush="#80FFFFFF"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,-8,0,-8"
                    IsHitTestVisible="False"/>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left">

                <Button x:Name="BrowseWojuModsButton"
                        Content="Browse Woju Mods"
                        MinWidth="160"
                        Height="30"
                        Padding="12,6"
                        Margin="0,0,8,0"
                        Click="BrowseWojuModsButton_Click"
                        Background="#FFCF7EFF"
                        FontFamily="Arial Black"
                        Foreground="White">

                    <Button.Effect>
                        <DropShadowEffect/>
                    </Button.Effect>

                </Button>

                <Button x:Name="DownloadRabbitFxButton"
                        Content="Download Latest RabbitFX"
                        MinWidth="210"
                        Height="30"
                        Padding="12,6"
                        Margin="0,0,8,0"
                        Click="DownloadRabbitFxButton_Click"
                        Background="White"
                        Width="140"/>

                <Button x:Name="TopUpWuWaButton"
                        Content="WuWa Top-Up (28% Off)"
                        MinWidth="170"
                        Height="30"
                        Padding="12,6"
                        Margin="0,0,8,0"
                        Click="TopUpWuWaButton_Click"
                        Background="#FFFFF900"
                        FontWeight="Bold"/>

                <Button x:Name="WojuKofiButton"
                        Content="Woju Ko-fi"
                        MinWidth="120"
                        Height="30"
                        Padding="12,6"
                        Click="WojuKofiButton_Click"
                        Background="White"/>

            </StackPanel>

            <Button x:Name="PatchOldIniButton"
                    Grid.Column="1"
                    Content="Patch OLD .ini"
                    Width="130"
                    Height="30"
                    Margin="10,0,0,0"
                    Click="PatchOldIniButton_Click"
                    Background="#FFCF7EFF"
                    FontWeight="Bold"
                    Foreground="White"
                    HorizontalAlignment="Right"/>

        </Grid>

        <!-- LOG -->
        <GroupBox Grid.Row="5"
                  Header="Log"
                  Grid.ColumnSpan="3">

            <Grid>

                <RichTextBox x:Name="LogTextBox"
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12"
                             Padding="8"
                             Background="#CC111111"
                             Foreground="White"
                             BorderBrush="#FF444444"
                             IsDocumentEnabled="False"/>

            </Grid>

        </GroupBox>

        <!-- Bottom buttons -->
        <Grid Grid.Row="6"
              Margin="0,12,0,0"
              Grid.ColumnSpan="3">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Frosted-glass panel behind the bottom action buttons -->
            <Border Grid.ColumnSpan="6"
                    Background="#BFFFFFFF"
                    BorderBrush="#80FFFFFF"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,-8,0,-8"
                    IsHitTestVisible="False"/>

            <!-- Run Fix -->
            <Button x:Name="RunButton"
                    Grid.Column="0"
                    Content="Run Fix"
                    Width="120"
                    Height="34"
                    Click="RunButton_Click"
                    Background="#FFCF7EFF"
                    FontWeight="Bold" Foreground="White"/>

            <!-- Add Derived Hash -->
            <Button x:Name="AddDerivedHashButton"
                    Grid.Column="1"
                    Content="Add Derived Hash"
                    Width="140"
                    Height="34"
                    Margin="10,0,0,0"
                    Click="AddDerivedHashButton_Click"
                    Background="White"
                    FontWeight="Bold"/>

            <!-- Revert -->
            <Button x:Name="RevertButton"
                    Grid.Column="2"
                    Content="Revert"
                    Width="120"
                    Height="34"
                    Margin="10,0,0,0"
                    Click="RevertButton_Click"
                    Background="#FFCF7EFF"
                    FontWeight="Bold" Foreground="White"/>

            <!-- Clear Log -->
            <Button x:Name="ClearLogButton"
                    Grid.Column="3"
                    Content="Clear Log"
                    Width="120"
                    Height="34"
                    Margin="10,0,0,0"
                    Click="ClearLogButton_Click"
                    Background="White"
                    FontWeight="Bold"/>

            <!-- Copy Logs -->
            <Button x:Name="CopyLogButton"
                    Grid.Column="4"
                    Content="Copy Logs"
                    Width="120"
                    Height="34"
                    Margin="10,0,0,0"
                    Click="CopyLogButton_Click"
                    Background="#FFCF7EFF"
                    FontWeight="Bold" Foreground="White"/>

            <!-- Author -->
            <StackPanel Grid.Column="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                <TextBlock Foreground="Black"
                           Text="Author: Woju"
                           Margin="0,0,12,0"/>

                <TextBlock Foreground="#FFCF7EFF"
                           Text="- Woju Fixer v3.8.1.0"/>

            </StackPanel>

        </Grid>

    </Grid>

</Window>