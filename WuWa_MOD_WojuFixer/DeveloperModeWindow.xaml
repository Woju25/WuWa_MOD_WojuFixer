<Window x:Class="WuWa_MOD_WojuFixer.DeveloperModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Woju - Developer Mode"
        Width="700"
        Height="500"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Foreground="#00FF00"
        FontFamily="Courier New"
        FontSize="12">
    <Grid>
        <StackPanel VerticalAlignment="Stretch" Margin="10">
            <!-- Title -->
            <TextBlock Text="Developer Mode"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,15"
                       Foreground="#00FF00"/>

            <!-- Menu Buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button x:Name="UpdateStableHashesButton"
                        Content="1. Update Stable Hashes"
                        Width="200"
                        Height="40"
                        Margin="0,0,10,0"
                        Background="#0D47A1"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="UpdateStableHashesButton_Click"/>

                <Button x:Name="UpdateHighLodHashesButton"
                        Content="2. Update High LOD Hashes"
                        Width="200"
                        Height="40"
                        Background="#0D47A1"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="UpdateHighLodHashesButton_Click"/>
            </StackPanel>

            <!-- Log Output (Terminal Style) -->
            <TextBlock Text="Process Log:"
                       Foreground="#00FF00"
                       Margin="0,0,0,5"
                       FontWeight="Bold"/>

            <TextBox x:Name="LogTextBox"
                     Background="#000000"
                     Foreground="#00FF00"
                     FontFamily="Courier New"
                     FontSize="11"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Padding="10"
                     Margin="0,0,0,15"
                     Height="300"
                     TextWrapping="Wrap"/>

            <!-- Close Button -->
            <Button x:Name="CloseButton"
                    Content="Close (ESC)"
                    Width="100"
                    Height="35"
                    HorizontalAlignment="Right"
                    Background="#D32F2F"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>